# Discord Webhook URL (Recommended - copy from Discord Server Settings -> Integrations -> Webhooks)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Optional: Discord Bot Token & Channel ID (Only if using Discord Bot API instead of Webhook)
# DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN
# DISCORD_CHANNEL_ID=YOUR_CHANNEL_ID

# Quote Selection Settings (daily, random, id)
SELECTION_MODE=daily

# Embed Theme (gold, crimson, ultramarine, mechanicus, charcoal, or custom hex like #D4AF37)
EMBED_COLOR=gold

# Optional: Specific quote ID (1 to 402)
# QUOTE_ID=42

# Optional: Filter random quotes by tag (Emperor, Heresy, Duty & Honor, War & Battle, Space Marines, etc.)
# TAG=Heresy

# Dry Run Mode (true/false) - print payload locally without sending
DRY_RUN=false
